# Copy thành file .env rồi điền. KHÔNG commit file .env.

# Bắt buộc nếu đăng Facebook Page (Reels API chỉ chạy trên Page)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Dùng khi đổi short-lived token → long-lived (~60 ngày)
# python3 src/fbtoken.py --short TOKEN
FB_APP_ID=
FB_APP_SECRET=

# Tùy chọn
FB_API_VERSION=v26.0
FB_DEFAULT_STATE=PUBLISHED
# PUBLISHED | DRAFT | SCHEDULED
# Lưu ý: docs Reels API chính thức chỉ nêu PUBLISHED.
# SCHEDULED / DRAFT có thể bị Graph API từ chối — thử DRAFT trước.

# Hashtag mặc định gắn cuối caption
DEFAULT_HASHTAGS=#taichinh #doisong #tucky

# ---------------------------------------------------------------------------
# Cross-post YouTube Shorts (Data API v3) — chỉ cần khi bật crosspost.targets
# Tạo OAuth client "Desktop app" trong Google Cloud Console, bật YouTube Data API v3,
# scope https://www.googleapis.com/auth/youtube.upload, rồi lấy refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Cross-post TikTok (Content Posting API) — cần app đã đăng ký + scope video.publish
# App chưa được TikTok duyệt chỉ đăng được ở chế độ riêng tư, nên mặc định là SELF_ONLY.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY

# ---------------------------------------------------------------------------
# Cảnh báo khi pipeline lỗi (không cấu hình = không gửi, lỗi sẽ im lặng)
# Telegram bot: tạo bot qua @BotFather rồi lấy chat id (nhắn cho bot, xem getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook chung: nhận POST JSON {"text": ..., "level": ..., "clip_id": ...}
NOTIFY_WEBHOOK_URL=
NOTIFY_LEVEL=warn
# info | warn | error — mức tối thiểu để gửi

# ---------------------------------------------------------------------------
# Chạy trong Docker (src/scheduler.py) — giờ UTC
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
# DOCTOR_STRICT=1 để container dừng khi doctor.py có [fail]
DOCTOR_STRICT=0
